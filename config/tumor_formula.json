{
  "description": "Same model as tumor.json written as a formula: decay function of x = t - t0 (counts per ns), convolved numerically with the resolution function. Intensities sum to 1 by construction (I4 = 0.9 - I1 - I3, fixed component 0.374 ns with 10%).",
  "input": {
    "format": "times",
    "column": 0
  },
  "histogram": {
    "bin_width": 0.02,
    "range": [0, 120]
  },
  "estimation": {
    "min_counts_first_bin": 8,
    "min_counts_last_bin": 8,
    "background": {
      "side": "right",
      "bins": 100,
      "skip_bins": 30,
      "n_sigma": 3
    },
    "fit_start_fraction": 0.3,
    "fit_end": 40
  },
  "model": {
    "type": "formula",
    "formula": "[A]*([I1]*exp(-x/[tau1])/[tau1] + 0.1*exp(-x/0.374)/0.374 + [I3]*exp(-x/[tau3])/[tau3] + (0.9-[I1]-[I3])*exp(-x/[tau4])/[tau4])",
    "convolve": true,
    "points_per_sigma": 5,
    "window_sigma": 8,
    "parameters": {
      "A": {"value": "estimate:area", "comment": "number of counts"},
      "I1": {"value": 0.3, "limits": [0, 0.9]},
      "I3": {"value": 0.5, "limits": [0, 0.9]},
      "tau1": {"value": 0.125, "limits": [0.08, 142], "stage": 1},
      "tau3": {"value": 0.3, "limits": [0.08, 142], "stage": 1},
      "tau4": {"value": 2.0, "limits": [0.08, 142], "stage": 1}
    }
  },
  "resolution": [
    {
      "sigma": 0.1,
      "intensity": 1.0
    }
  ],
  "fit": {
    "iterations": 3,
    "partial_variation_percent": 5,
    "lifetime_limits": [0.08, 142.0],
    "sigma_limits": [0.01, 5.0],
    "offset_window_sigma": 5,
    "ops_lifetime_threshold": 0.7,
    "first_pass_options": "RMW",
    "options": "RM"
  },
  "output": {
    "directory": "Results",
    "timestamp": true
  }
}
